    { "id": "vco-2", "type": "vco", "slot": [0, 3], "params": { "octave": -3, "tune": -3, "shape": 3, "pulseWidth": 0.5, "fmAmount": 2.8 } },
    { "id": "adsr-1", "type": "adsr", "slot": [0, 4], "params": { "attack": 0.001, "decay": 0.32, "sustain": 0, "release": 0.2 } },
